# Entorno
APP_NAME="Podemos Peru API"
ENVIRONMENT=development
DEBUG=true

# Base de datos (interna del compose; no se expone al exterior)
POSTGRES_USER=podemos
POSTGRES_PASSWORD=podemos
POSTGRES_DB=podemos_peru
# URL usada al ejecutar la API fuera de Docker (host local)
DATABASE_URL=postgresql+psycopg://podemos:podemos@localhost:5432/podemos_peru

# Puerto del host donde se publica la API (solo en 127.0.0.1, para Nginx)
API_PORT=8477

# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS: dominios del frontend en produccion (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Carga inicial de datos
SEED_ON_STARTUP=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Consulta de DNI (apisperu). El token nunca se expone al frontend.
APISPERU_TOKEN=
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1
